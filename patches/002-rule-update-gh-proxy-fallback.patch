From 3a028a33bbc6463bde8e75048ad657e6c7e79388 Mon Sep 17 00:00:00 2001
From: Jackie Han <jackie.han@gmail.com>
Date: Fri, 30 Oct 2026 21:41:26 +0800
Subject: [PATCH] rule_update: retry through gh-proxy when direct GitHub
 download fails

When the configured geoip/geosite URL points at github.com and the direct
download fails, retry once with the gh-proxy.org prefix. URLs that are not
on github.com (or already proxied) are left untouched.
---
 .../root/usr/share/passwall2/rule_update.lua     | 16 ++++++++++++++--
 1 file changed, 14 insertions(+), 2 deletions(-)

diff --git a/luci-app-passwall2/root/usr/share/passwall2/rule_update.lua b/luci-app-passwall2/root/usr/share/passwall2/rule_update.lua
index d5e98bb..22203d5 100755
--- a/luci-app-passwall2/root/usr/share/passwall2/rule_update.lua
+++ b/luci-app-passwall2/root/usr/share/passwall2/rule_update.lua
@@ -272,12 +272,24 @@ local function fetch_geofile(geo_name, geo_type, url)
 	return 0
 end
 
+local GH_PROXY = "https://gh-proxy.org/"
+
+-- Retry through gh-proxy when a direct GitHub download fails.
+local function fetch_with_fallback(geo_name, geo_type, url)
+	local ret = fetch_geofile(geo_name, geo_type, url)
+	if ret == 1 and url:match("^https://github%.com/") then
+		log(1, string.format("%s direct download failed, retrying via gh-proxy...", geo_type))
+		ret = fetch_geofile(geo_name, geo_type, GH_PROXY .. url)
+	end
+	return ret
+end
+
 local function fetch_geoip()
-	fetch_geofile("geoip.dat", "geoip", geoip_url)
+	return fetch_with_fallback("geoip.dat", "geoip", geoip_url)
 end
 
 local function fetch_geosite()
-	fetch_geofile("geosite.dat", "geosite", geosite_url)
+	return fetch_with_fallback("geosite.dat", "geosite", geosite_url)
 end
 
 local function remove_tmp_geofile(name)
