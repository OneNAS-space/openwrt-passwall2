From c6ca20d7b1e03b3828eabf837c423a1dff9dd7e9 Mon Sep 17 00:00:00 2001
From: Jackie Han <jackie.han@gmail.com>
Date: Fri, 30 Oct 2026 13:43:53 +0800
Subject: [PATCH] nftables: skip firewall rules of an ACL whose core failed to
 start

load_acl() starts the cores through acl_node() and then adds the redirect/
TPROXY and DNS rules for every ACL unconditionally. When a core fails its
"run -test" (for example because geoip.dat/geosite.dat is corrupted),
acl_node() only logs the error, so the rules end up pointing at a port
nobody listens on and the network is cut.

acl_node() removes acl_node_<flag> only after the core started, so a file
that is still there marks a failed ACL. Skip the rules of such an ACL so
its traffic goes direct.
---
 luci-app-passwall2/root/usr/share/passwall2/nftables.sh | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/luci-app-passwall2/root/usr/share/passwall2/nftables.sh b/luci-app-passwall2/root/usr/share/passwall2/nftables.sh
index 2a110c0..db0c7c3 100755
--- a/luci-app-passwall2/root/usr/share/passwall2/nftables.sh
+++ b/luci-app-passwall2/root/usr/share/passwall2/nftables.sh
@@ -279,6 +279,10 @@ load_acl() {
 	log_i18n 1 "Access Control:"
 	acl_node
 	for sid in $(jsonfilter -s "${ACL_JSON}" -e '$.acl[*].flag'); do
+		[ -f "${TMP_ACL_PATH}/acl_node_${sid}" ] && {
+			log 2 "[${sid}] core failed to start, skip its firewall rules, direct connection is used."
+			continue
+		}
 		eval $(cat "${TMP_ACL_PATH}/${sid}/var")
 
 		[ -z "$(get_cache_var "node_${node}_gen_shunt_list")" ] && [ -n "${node}" ] && gen_shunt_list "${node}" shunt_list4 shunt_list6
-- 
