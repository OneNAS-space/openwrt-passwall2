From 9ccd6fbfcc8346d263271e1f7ac9cffcc2af7e1e Mon Sep 17 00:00:00 2001
From: Jackie Han <jackie.han@gmail.com>
Date: Fri, 30 Oct 2026 06:36:13 +0800
Subject: [PATCH] Update passwall2 initialization script

Added checks and fixes for passwall2 configuration and permissions.
---
 .../root/etc/uci-defaults/luci-app-passwall2       | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/luci-app-passwall2/root/etc/uci-defaults/luci-app-passwall2 b/luci-app-passwall2/root/etc/uci-defaults/luci-app-passwall2
index 85cd4ee4a..7b4103a88 100644
--- a/luci-app-passwall2/root/etc/uci-defaults/luci-app-passwall2
+++ b/luci-app-passwall2/root/etc/uci-defaults/luci-app-passwall2
@@ -30,7 +30,19 @@ else
 fi
 uci commit firewall
 
-[ ! -s "/etc/config/passwall2" ] && cp -f /usr/share/passwall2/0_default_config /etc/config/passwall2
+if [ ! -s "/etc/config/passwall2" ]; then
+    cp -f /usr/share/passwall2/0_default_config /etc/config/passwall2
+fi
+
+_patched=0
+for _bad_key in $(uci -q show passwall2 | grep -E "\.(tcp|udp)_no_redir_ports='disable'" | cut -d '=' -f 1); do
+    uci -q set "$_bad_key="
+    _patched=1
+done
+
+if [ "$_patched" -eq 1 ]; then
+    uci commit passwall2
+fi
 
 chmod +x /usr/share/passwall2/*.sh
 
