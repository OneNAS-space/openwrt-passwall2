From ddf27304dfbceb997f7e576bf9f823e896e5042a Mon Sep 17 00:00:00 2001
From: Jackie Han <jackie.han@gmail.com>
Date: Fri, 30 Oct 2026 21:41:26 +0800
Subject: [PATCH] monitor: stop PassWall2 when a core cannot be brought back

monitor.sh only restarted a crashed process every minute and never touched
the firewall rules, so a core that keeps failing to start left the
redirect/TPROXY rules and the dnsmasq upstream pointing at a dead process
and the network stayed cut.

For xray/sing-box, retry the restart up to 3 times, 10 seconds apart. If
the core is still not running, stop PassWall2 (which removes the firewall
rules and restores dnsmasq) so traffic goes direct again. Other monitored
processes keep the old behaviour.
---
 .../root/usr/share/passwall2/monitor.sh       | 43 ++++++++++++++++---
 1 file changed, 36 insertions(+), 7 deletions(-)

diff --git a/luci-app-passwall2/root/usr/share/passwall2/monitor.sh b/luci-app-passwall2/root/usr/share/passwall2/monitor.sh
index 30830a7..d4b4f86 100755
--- a/luci-app-passwall2/root/usr/share/passwall2/monitor.sh
+++ b/luci-app-passwall2/root/usr/share/passwall2/monitor.sh
@@ -7,6 +7,24 @@ ENABLED=$(config_n_get @global[0] enabled 0)
 [ "$ENABLED" != 1 ] && return 1
 ENABLED=$(config_n_get @global_delay[0] start_daemon 0)
 [ "$ENABLED" != 1 ] && return 1
+
+# Fail-open: if a core (xray/sing-box) cannot be brought back after MAX_RETRY
+# restarts in a row, stop PassWall2 so traffic goes direct again instead of
+# being redirected to a dead process.
+MAX_RETRY=3
+RETRY_WAIT=10
+
+is_running() {
+	local cmd_check escape_cmd
+	cmd_check=$(echo $1 | awk -F '>' '{print $1}')
+	escape_cmd="$(echo $cmd_check | sed 's/[^a-zA-Z0-9]/\\&/g')"
+	[ "$(busybox pgrep -f "${escape_cmd}" | wc -l)" != 0 ]
+}
+
+run_cmd() {
+	eval $(echo "nohup ${1} 2>&1 &") >/dev/null 2>&1 &
+}
+
 sleep 58s
 while [ "$ENABLED" -eq 1 ]; do
 	[ -f "$LOCK_FILE" ] && {
@@ -17,13 +35,24 @@ while [ "$ENABLED" -eq 1 ]; do
 	[ -d ${TMP_SCRIPT_FUNC_PATH} ] && {
 		for filename in $(ls ${TMP_SCRIPT_FUNC_PATH} | grep -v "^_"); do
 			cmd=$(cat ${TMP_SCRIPT_FUNC_PATH}/${filename})
-			cmd_check=$(echo $cmd | awk -F '>' '{print $1}')
-			escape_cmd="$(echo $cmd_check | sed 's/[^a-zA-Z0-9]/\\&/g')"
-			icount=$(busybox pgrep -f "${escape_cmd}" | wc -l)
-			if [ $icount = 0 ]; then
-				log 0 "${cmd} crashed, restarting."
-				eval $(echo "nohup ${cmd} 2>&1 &") >/dev/null 2>&1 &
-			fi
+			is_running "$cmd" && continue
+			log 0 "${cmd} crashed, restarting."
+			run_cmd "$cmd"
+			echo "$cmd" | grep -qE '(^|/)(xray|sing-box) ' || continue
+			try=1
+			sleep $RETRY_WAIT
+			while ! is_running "$cmd"; do
+				if [ "$try" -ge "$MAX_RETRY" ]; then
+					log 0 "${cmd} failed to restart ${MAX_RETRY} times, stopping PassWall2 to restore direct access."
+					rm -f $LOCK_FILE
+					( /etc/init.d/${CONFIG} stop >/dev/null 2>&1 & )
+					exit 0
+				fi
+				try=$((try + 1))
+				log 0 "${cmd} is still not running, retry ${try}/${MAX_RETRY}."
+				run_cmd "$cmd"
+				sleep $RETRY_WAIT
+			done
 		done
 	}
 
