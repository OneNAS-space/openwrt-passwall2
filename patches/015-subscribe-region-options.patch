Subject: [PATCH] luci-app-passwall2: add region grouping options to the subscription settings

Add the "Group Nodes by Region" and "Generate Region Balancing Nodes" options
to the subscription settings (both off by default).

Renaming a subscription and the node count now follow sub_src as well, and
deleting a subscribed node still clears the MD5 of its subscription.
---
diff --git a/luci-app-passwall2/luasrc/model/cbi/passwall2/client/node_subscribe_config.lua b/luci-app-passwall2/luasrc/model/cbi/passwall2/client/node_subscribe_config.lua
--- a/luci-app-passwall2/luasrc/model/cbi/passwall2/client/node_subscribe_config.lua
+++ b/luci-app-passwall2/luasrc/model/cbi/passwall2/client/node_subscribe_config.lua
@@ -89,8 +89,10 @@
 	local old = m:get(section, self.option) or ""
 	if old ~= value then
 		m:foreach("nodes", function(e)
-			if e["group"] and e["group"]:lower() == old:lower() then
-				self.map:set(e[".name"], "group", value)
+			-- Nodes in a region group keep the name of their subscription in sub_src.
+			local field = (e["sub_src"] and e["sub_src"] ~= "") and "sub_src" or "group"
+			if e[field] and e[field]:lower() == old:lower() then
+				self.map:set(e[".name"], field, value)
 			end
 			if e["protocol"] and (e["protocol"] == "_balancing" or e["protocol"] == "_urltest") and e["node_group"] then
 				local gs = ""
@@ -174,6 +176,16 @@
 o:depends("filter_keyword_mode", "2")
 o:depends("filter_keyword_mode", "3")
 o:depends("filter_keyword_mode", "4")
+
+o = s:option(Flag, "region_group", translate("Group Nodes by Region"))
+o.default = 0
+o.description = translate("Put the nodes of this subscription into one group per region (HK, JP, US ...), recognized from the node remarks.") .. "<br>" ..
+		translate("Nodes whose region cannot be recognized stay in the group named after the subscription. Takes effect at the next subscription update.")
+
+o = s:option(Flag, "region_balancing", translate("Generate Region Balancing Nodes"))
+o.default = 0
+o:depends("region_group", "1")
+o.description = translate("Create an Xray load balancing node for every region that has nodes. An existing Xray batch balancing node with the region code as its remarks is kept; the region is added to its node group.")
 
 if #ss_type > 0 then
 	o = s:option(ListValue, "ss_type", translatef("%s Node Use Type", "Shadowsocks"))
diff --git a/luci-app-passwall2/luasrc/model/cbi/passwall2/client/node_subscribe.lua b/luci-app-passwall2/luasrc/model/cbi/passwall2/client/node_subscribe.lua
--- a/luci-app-passwall2/luasrc/model/cbi/passwall2/client/node_subscribe.lua
+++ b/luci-app-passwall2/luasrc/model/cbi/passwall2/client/node_subscribe.lua
@@ -166,8 +166,10 @@
 	local old = m:get(section, self.option) or ""
 	if old ~= value then
 		m:foreach("nodes", function(e)
-			if e["group"] and e["group"]:lower() == old:lower() then
-				m:set(e[".name"], "group", value)
+			-- Nodes in a region group keep the name of their subscription in sub_src.
+			local field = (e["sub_src"] and e["sub_src"] ~= "") and "sub_src" or "group"
+			if e[field] and e[field]:lower() == old:lower() then
+				m:set(e[".name"], field, value)
 			end
 			if e["protocol"] and (e["protocol"] == "_balancing" or e["protocol"] == "_urltest") and e["node_group"] then
 				local gs = ""
@@ -198,7 +200,8 @@
 	str = str ~= "" and "<br>" .. str or ""
 	local num = 0
 	m:foreach("nodes", function(s)
-		if s["group"] and s["group"]:lower() == remark:lower() then
+		local sub = (s["sub_src"] and s["sub_src"] ~= "") and s["sub_src"] or s["group"]
+		if sub and sub:lower() == remark:lower() then
 			num = num + 1
 		end
 	end)
diff --git a/luci-app-passwall2/luasrc/controller/passwall2.lua b/luci-app-passwall2/luasrc/controller/passwall2.lua
--- a/luci-app-passwall2/luasrc/controller/passwall2.lua
+++ b/luci-app-passwall2/luasrc/controller/passwall2.lua
@@ -617,7 +617,8 @@
 			end
 		end)
 		if (uci_get(w, "add_mode") or "0") == "2" then
-			local group = uci_get(w, "group") or ""
+			local group = uci_get(w, "sub_src") or ""
+			if group == "" then group = uci_get(w, "group") or "" end
 			if group ~= "" then
 				uci_foreach("subscribe_list", function(t)
 					if t["remark"] == group then
