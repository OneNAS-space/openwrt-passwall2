From 4f7147d07f0f3b80ba87ec0f0204183874280dba Mon Sep 17 00:00:00 2001
From: Jackie Han <jackie.han@gmail.com>
Date: Mon, 16 Nov 2026 11:30:00 +0800
Subject: [PATCH] nodes_listvalue: use CSS ellipsis for label text

Remove the custom ellipsis handling for label text and rely on CSS for
text overflow.
---
 .../passwall2/cbi/nodes_listvalue_com.htm     | 68 ++++---------------
 1 file changed, 12 insertions(+), 56 deletions(-)

diff --git a/luci-app-passwall2/luasrc/view/passwall2/cbi/nodes_listvalue_com.htm b/luci-app-passwall2/luasrc/view/passwall2/cbi/nodes_listvalue_com.htm
index 3eb061cb..8e6ce90e 100644
--- a/luci-app-passwall2/luasrc/view/passwall2/cbi/nodes_listvalue_com.htm
+++ b/luci-app-passwall2/luasrc/view/passwall2/cbi/nodes_listvalue_com.htm
@@ -84,11 +84,17 @@
 }
 .lv-dropdown-label {
 	display: inline-block;
+	flex: 1 1 auto;
+	min-width: 0;
 	overflow: hidden;
+	text-overflow: ellipsis;
 	white-space: nowrap;
 	width: 100%;
 	text-align: left;
 }
+.lv-dropdown-display .lv-arrow-down {
+	flex: none;
+}
 .lv-dropdown-panel {
 	position: fixed;
 	top: 0;
@@ -328,8 +334,10 @@
 			const panelRadius = styleSelect.borderRadius;
 			const optionColor = colors.backgroundColor;
 			const titleColor = lv_getColorSchema(optionColor) === "light" ? lv_darker(optionColor, 30) : lv_lighter(optionColor, 30)
-			// 自带箭头已占据布局空间，右内边距使用主题的左内边距
-			const selectStyleCSS = [`#${CSS.escape(cbid + ".display")} {`, lv_style2Css(styleSelect, styleNames), lv_style2Css(styleSelect, ["backgroundColor"]), `padding-right: ${styleSelect.paddingLeft} !important;`, "}"]
+			// 自带箭头已占据布局空间，左右内边距对称，不再保留原生 select 为箭头预留的空间
+			// Some themes (e.g. Bootstrap) rely on the browser's built-in inner padding and set only ~4px, which looks cramped on a div, so keep a minimum.
+			const padX = Math.max(parseFloat(styleSelect.paddingLeft) || 0, 8) + "px";
+			const selectStyleCSS = [`#${CSS.escape(cbid + ".display")} {`, lv_style2Css(styleSelect, styleNames), lv_style2Css(styleSelect, ["backgroundColor"]), `padding-left: ${padX}; padding-right: ${padX} !important;`, "}"]
 			const optionStyleCSS = [`#${CSS.escape(cbid + ".panel")}  {`, lv_style2Css(styleOption, styleNames), `background-color: ${optionColor};`, `color: ${colors.color};`, `border-radius: ${panelRadius};`, `color-scheme: ${styleSelect.colorScheme};`, `--lv-selected-background: ${colors.selectedBackground};`, `--lv-selected-color: ${colors.selectedColor};`, `--lv-hover-background: ${titleColor};`, "}"]
 			const titleStyleCSS = [`#${CSS.escape(cbid + ".panel")} .lv-group-title  {`, `background-color: ${titleColor} !important;`, `color: ${colors.color};`, "}"]
 			styleNode.textContent = [].concat(selectStyleCSS, optionStyleCSS, titleStyleCSS).join("\n")
@@ -757,52 +765,9 @@
 		}, { passive: false });
 	}
 
-	//截断display字符长度
-	window.lv_labelSpan_maxWidth = {};
+	// 截断由 CSS (text-overflow: ellipsis) 完成，随字体加载/布局变化自动重算；这里仅保留接口
 	function lv_ellipsisByWidth(cbid, text) {
-		const el = document.getElementById(cbid + ".label");
-		if (!el || !text) return text;
-		text = text.trim();
-		const maxWidth = el.clientWidth;
-		window.lv_labelSpan_maxWidth[cbid] = maxWidth;
-		if (maxWidth <= 0) return text;
-		const style = window.getComputedStyle(el);
-		const font = [
-			style.fontStyle,
-			style.fontVariant,
-			style.fontWeight,
-			style.fontSize || '16px',
-			style.fontFamily || 'sans-serif'
-		].join(" ").replace(/\s+/g, ' ');
-		const canvas = lv_ellipsisByWidth._canvas || (lv_ellipsisByWidth._canvas = document.createElement("canvas"));
-		const ctx = canvas.getContext("2d");
-		ctx.font = font;
-		if (ctx.measureText(text).width <= maxWidth) {
-			return text;
-		}
-		const ellipsis = "...";
-		const ellipsisWidth = ctx.measureText(ellipsis).width;
-		const minChars = 15;
-		const probe = text.slice(0, minChars);
-		const probeWidth = ctx.measureText(probe).width;
-		if (probeWidth + ellipsisWidth > maxWidth) {
-			return text;
-		}
-		let left = 0;
-		let right = text.length;
-		let result = ellipsis;
-		while (left <= right) {
-			const mid = (left + right) >> 1;
-			const substr = text.slice(0, mid);
-			const w = ctx.measureText(substr).width;
-			if (w + ellipsisWidth <= maxWidth) {
-				result = substr + ellipsis;
-				left = mid + 1;
-			} else {
-				right = mid - 1;
-			}
-		}
-		return result;
+		return (text || "").trim();
 	}
 
 	const lv_adaptiveControls = new Set();
@@ -810,14 +775,6 @@
 		lv_adaptiveControls.add(cbid);
 		lv_adaptiveStyle(cbid);
 	}
-	function lv_labelSpanResize(cbid) {
-		const el = document.getElementById(cbid + ".label");
-		if (!el) return;
-		const maxWidth = el.clientWidth;
-		if (window.lv_labelSpan_maxWidth[cbid] == maxWidth) return;
-		let text = el.title;
-		el.textContent = lv_ellipsisByWidth(cbid, text);
-	}
 	let lv_adaptiveTicking = false;
 	window.addEventListener("resize", () => {
 		if (!lv_adaptiveTicking) {
@@ -825,7 +782,6 @@
 			requestAnimationFrame(() => {
 				lv_adaptiveControls.forEach(cbid => {
 					lv_adaptiveStyle(cbid);
-					lv_labelSpanResize(cbid);
 				});
 				lv_adaptiveTicking = false;
 			});
