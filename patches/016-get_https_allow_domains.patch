From 1b37444cfbf447281e6dbb9955eaece02da536ac Mon Sep 17 00:00:00 2001
From: Jackie Han <jackie.han@gmail.com>
Date: Thu, 26 Nov 2026 16:20:21 +0800
Subject: [PATCH] Implement get_https_allow_domains function

Add function to retrieve allowed HTTPS domains from a file.
---
 .../luasrc/passwall2/util_xray.lua            | 25 +++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/luci-app-passwall2/luasrc/passwall2/util_xray.lua b/luci-app-passwall2/luasrc/passwall2/util_xray.lua
index 142bc58d..06272d86 100644
--- a/luci-app-passwall2/luasrc/passwall2/util_xray.lua
+++ b/luci-app-passwall2/luasrc/passwall2/util_xray.lua
@@ -29,6 +29,21 @@ local function get_domain_excluded()
 	return hosts
 end
 
+local function get_https_allow_domains()
+	local path = "/usr/share/passwall2/dns_https_allow"
+	local content = fs.readfile(path)
+	if not content then return nil end
+	local domains = {}
+	string.gsub(content, '[^' .. "\n" .. ']+', function(w)
+		local s = api.trim(w)
+		if s == "" then return end
+		if s:find("#") == 1 then return end
+		table.insert(domains, s)
+	end)
+	if #domains == 0 then domains = nil end
+	return domains
+end
+
 local function get_log_level(s)
 	if s == "warn" then s = "warning" end
 	return s
@@ -1869,6 +1884,16 @@ function gen_config(var)
 					sockopt = { dialerProxy = "direct" }
 				}
 			}
+			local https_allow_domains = get_https_allow_domains()
+			if https_allow_domains then
+				-- Insert before the "qType = 65 -> return" rule (index 2), so HTTPS/SVCB queries
+				-- of the listed domains are forwarded to the direct DNS instead of being blocked.
+				table.insert(direct_type_dns.settings.rules, 2, {
+					qType = 65,
+					action = "direct",
+					domain = https_allow_domains
+				})
+			end
 			local remote_type_dns = {
 				settings = {
 					rewriteAddress = remote_dns_udp_server,
