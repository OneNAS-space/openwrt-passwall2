+				let tab_content_html = '<div class="cbi-section-shunt_rule cbi-section-shunt_rule-tabbed" id="cbi-<%=appname%>-shunt_rules">';
 				if (li) {
 					tab_ul_html += li;
 				}
@@ -436,7 +436,7 @@ <h3>Sing-Box/Xray <%:Shunt Rule%></h3>
 					tab_content_html += content;
 				}
 				tab_ul_html += '</ul>';
-				tab_content_html += '</fieldset>';
+				tab_content_html += '</div>';
 				return tab_ul_html + tab_content_html;
 			}
 
