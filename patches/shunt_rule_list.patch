+	<div class="cbi-tblsection" id="cbi-<%=appname%>-shunt_rules-{{group}}-fieldset">
 		<table class="table cbi-section-table" id="cbi-<%=appname%>-shunt_rules-{{group}}-table" style="">
 			<tr class="tr cbi-section-table-titles anonymous">
