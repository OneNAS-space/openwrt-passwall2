+	// Align the filter bar (created by node_list_sort.js) with the left edge of the first tab.
+	// The offset is measured instead of hard-coded, because it depends on the theme.
+	function pw_align_filter() {
+		const menu = document.querySelector("#node_list .cbi-tabmenu");
+		const tab = menu ? menu.querySelector("li") : null;
+		if (!tab) return;
+		const targetLeft = tab.getBoundingClientRect().left;
+		const menuBottom = menu.getBoundingClientRect().bottom;
+		document.querySelectorAll("#node_list .pw-filter").forEach(function(f) {
+			if (f.getClientRects().length === 0) return; // filter of a hidden tab
+
+			// Horizontal: line up with the first tab.
+			// Padding does not move the left border edge, so the current padding does not disturb the measurement.
+			const pad = Math.max(0, Math.round(targetLeft - f.getBoundingClientRect().left)) + "px";
+			if (f.style.paddingLeft !== pad)
+				f.style.paddingLeft = pad;
+
+			// Vertical: keep the bar as close to the tab bar as its own default margin (0.4em).
+			// Some themes add a large gap below the tabs (e.g. bootstrap: 18px margin + 9px fieldset padding);
+			// measure it and cancel the surplus with the top margin. A theme whose gap already matches is left alone.
+			const style = window.getComputedStyle(f);
+			const want = (parseFloat(style.fontSize) || 14) * 0.4;
+			const gap = f.getBoundingClientRect().top - menuBottom;
+			if (Math.abs(gap - want) > 3) {
+				const cur = parseFloat(style.marginTop) || 0;
+				f.style.marginTop = (cur + want - gap) + "px";
+			}
+		});
+	}
+
+	// Also re-align after every tab switch, including switches made by LuCI itself.
+	if (typeof cbi_t_switch === "function") {
+		const ori_switch_for_filter = cbi_t_switch;
+		cbi_t_switch = function(section, tab) {
+			const ret = ori_switch_for_filter(section, tab);
+			pw_align_filter();
+			return ret;
+		};
+	}
+
+	// Re-align whenever the list is (re)built or the filter bar is re-rendered, and on resize.
+	(function() {
+		const root = document.getElementById("node_list");
+		if (!root || typeof MutationObserver === "undefined") return;
+		let queued = false;
+		new MutationObserver(function() {
+			if (queued) return;
+			queued = true;
+			requestAnimationFrame(function() {
+				queued = false;
+				pw_align_filter();
+			});
+		}).observe(root, { childList: true, subtree: true });
+		window.addEventListener("resize", pw_align_filter);
+	})();
