Subject: [PATCH] Potential fix for code scanning alert no. 11: DOM text
 reinterpreted as HTML

Co-authored-by: Copilot Autofix powered by AI <62310815+github-advanced-security[bot]@users.noreply.github.com>
---
 .../luasrc/view/passwall2/global/footer.htm               | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/luci-app-passwall2/luasrc/view/passwall2/global/footer.htm b/luci-app-passwall2/luasrc/view/passwall2/global/footer.htm
index a279f3b7..2830cae4 100644
--- a/luci-app-passwall2/luasrc/view/passwall2/global/footer.htm
+++ b/luci-app-passwall2/luasrc/view/passwall2/global/footer.htm
@@ -58,9 +58,13 @@
 		if (!node_select_value || node_select_value.indexOf("_default") === 0 || node_select_value.indexOf("_direct") === 0 || node_select_value.indexOf("_blackhole") === 0) {
 			return;
 		}
-		let to_url = '<%=api.url("node_config")%>/' + node_select_value;
+		if (!/^[A-Za-z0-9_.-]+$/.test(node_select_value)) {
+			return;
+		}
+		const encoded_node_select_value = encodeURIComponent(node_select_value);
+		let to_url = '<%=api.url("node_config")%>/' + encoded_node_select_value;
 		if (node_select_value.indexOf("socks_") === 0) {
-			to_url = '<%=api.url("socks_config")%>/' + node_select_value;
+			to_url = '<%=api.url("socks_config")%>/' + encoded_node_select_value;
 		}
 		location.href = to_url;
 	}
