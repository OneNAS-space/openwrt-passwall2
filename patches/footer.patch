From: Jackie264 <jackie.han@gmail.com>
Date: Sun, 9 Aug 2026 15:43:17 +0800
Subject: [PATCH] Encode URL parameter for protocol selection

---
 luci-app-passwall2/luasrc/view/passwall2/node_config/footer.htm | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/luci-app-passwall2/luasrc/view/passwall2/node_config/footer.htm b/luci-app-passwall2/luasrc/view/passwall2/node_config/footer.htm
index b2cfd367..85585217 100644
--- a/luci-app-passwall2/luasrc/view/passwall2/node_config/footer.htm
+++ b/luci-app-passwall2/luasrc/view/passwall2/node_config/footer.htm
@@ -48,7 +48,7 @@
 							protocol: getOption("<%=self.config%>", "<%=self.section%>", name).value,
 						}, node_config_url);
 					} else {
-						window.location.href = node_config_url + "?select_proto=" + el.value;
+						window.location.href = node_config_url + "?select_proto=" + encodeURIComponent(el.value);
 					}
 				}
 			});
