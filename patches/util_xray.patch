+++ b/luci-app-passwall2/luasrc/passwall2/util_xray.lua
@@ -1002,7 +1002,7 @@ function gen_config(var)
 			}
 			return result
 		end
-		if section[".type"] == "nodes" then
+		if section[".type"] == "nodes" or section[".type"] == "shunt_rules" then
 			return section
 		end
 		return nil
