From 7239ad47cdaad731c9eb5a6b8d23008e0cf42d27 Mon Sep 17 00:00:00 2001
From: Jackie Han <jackie.han@gmail.com>
Date: Fri, 30 Oct 2026 14:08:51 +0800
Subject: [PATCH] app: re-download geo rules once when xray fails to load them

When a core fails its "run -test" because geoip.dat/geosite.dat cannot be
loaded (xray reports it under common/geodata), the transparent proxy of
that ACL is skipped and traffic goes direct. Also fetch the rule files
again in the background; rule_update.lua restarts the service when the
files were replaced.

A marker under /var/lock limits this to one automatic attempt per boot, so
a downloaded file that is still unusable cannot cause a download/restart
loop.
---
 luci-app-passwall2/root/usr/share/passwall2/app.sh | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/luci-app-passwall2/root/usr/share/passwall2/app.sh b/luci-app-passwall2/root/usr/share/passwall2/app.sh
index c00e32b..7548ae1 100755
--- a/luci-app-passwall2/root/usr/share/passwall2/app.sh
+++ b/luci-app-passwall2/root/usr/share/passwall2/app.sh
@@ -855,6 +855,11 @@ acl_node() {
 		if [ "$status" != 0 ]; then
 			log_i18n 2 "[%s] process %s error, skip this transparent proxy!" "${node}" "${config_file}"
 			cat ${_error_log_file} >> ${LOG_FILE}
+			[ ! -e "${LOCK_PATH}/${CONFIG}_geo_healed" ] && grep -q 'common/geodata' "${_error_log_file}" 2>/dev/null && {
+				touch "${LOCK_PATH}/${CONFIG}_geo_healed"
+				log 2 "Geo rule files seem to be corrupted, re-downloading them in the background."
+				{ lua $APP_PATH/rule_update.lua log geoip,geosite >/dev/null 2>&1 & }
+			}
 			unset _error_log_file
 			continue
 		fi
