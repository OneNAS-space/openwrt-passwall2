From 0cb3511abe59fc9c652bff0d025472d5a4acc637 Mon Sep 17 00:00:00 2001
From: Jackie Han <jackie.han@gmail.com>
Date: Thu, 26 Nov 2026 16:48:48 +0800
Subject: [PATCH] Implement DNS HTTPS/SVCB allow list option

Add option to allow specific HTTPS/SVCB records through DNS.
---
 .../luasrc/model/cbi/passwall2/client/global.lua            | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/luci-app-passwall2/luasrc/model/cbi/passwall2/client/global.lua b/luci-app-passwall2/luasrc/model/cbi/passwall2/client/global.lua
index 2304c288..13dab7a6 100644
--- a/luci-app-passwall2/luasrc/model/cbi/passwall2/client/global.lua
+++ b/luci-app-passwall2/luasrc/model/cbi/passwall2/client/global.lua
@@ -282,6 +282,17 @@ o.remove = function(self, section)
 	end
 end
 
+if not (m.is_js_luci and current_node.type == "sing-box") then
+	o = s:taboption("DNS", TextValue, "dns_https_allow", translate("HTTPS/SVCB Record Allow List"),
+		translate("HTTPS/SVCB (TYPE65) queries for the listed domains are forwarded to the direct DNS instead of being blocked. One entry per line. The domain: and full: prefixes are supported; lines starting with # are comments. Xray only; list only domains that go direct."))
+	o.rows = 5
+	o.wrap = "off"
+	o.placeholder = "domain:example.com"
+	if not m.is_js_luci then
+		o:depends({ _is_singbox = "1", ["!reverse"] = true })
+	end
+end
+
 o = s:taboption("DNS", Flag, "dns_redirect", translate("DNS Redirect"), translate("Force special DNS server to need proxy devices."))
 o.default = "1"
 o.rmempty = false
