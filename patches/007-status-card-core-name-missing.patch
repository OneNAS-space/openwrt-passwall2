From a5037bc04ec245e890b7df0d2162a1cab495e645 Mon Sep 17 00:00:00 2001
From: Jackie Han <jackie.han@gmail.com>
Date: Fri, 30 Oct 2026 21:41:27 +0800
Subject: [PATCH] luci-app-passwall2: show core name and missing-core hint on
 status card

The Core status card on the Main page now shows the actual core in use
(Xray / Sing-Box) instead of the hardcoded "Core". The name is taken from
the running core process, or from the default node type when stopped.

When neither xray nor sing-box is installed and the service is not running,
the card shows "NOT INSTALLED" and becomes clickable, jumping to the App
Update page. The card is built with DOM APIs instead of innerHTML.
---
 .../luasrc/controller/passwall2.lua           | 14 +++++++-
 .../luasrc/view/passwall2/global/status.htm   | 33 +++++++++++++++----
 2 files changed, 39 insertions(+), 8 deletions(-)

diff --git a/luci-app-passwall2/luasrc/controller/passwall2.lua b/luci-app-passwall2/luasrc/controller/passwall2.lua
index 36e4ed5..57e3b5d 100644
--- a/luci-app-passwall2/luasrc/controller/passwall2.lua
+++ b/luci-app-passwall2/luasrc/controller/passwall2.lua
@@ -282,7 +282,19 @@ end
 
 function index_status()
 	local e = {}
-	e["global_status"] = luci.sys.call("/bin/busybox top -bn1 | grep -v 'grep' | grep '%s/bin/' | grep '/acl_default\\.json' >/dev/null" % api.TMP_PATH) == 0
+	local coms = require "luci.passwall2.com"
+	local out = luci.sys.exec("/bin/busybox top -bn1 | grep -v 'grep' | grep '%s/bin/' | grep '/acl_default\\.json'" % api.TMP_PATH)
+	e["global_status"] = out ~= ""
+	local name = out:match("/bin/([%w%-]+) ")
+	if not name then
+		local node = uci_get("@global[0]", "node")
+		name = node and uci_get(node, "type")
+	end
+	name = name and name:lower()
+	e["core_name"] = name and coms[name] and coms[name].name or nil
+	if not e["global_status"] then
+		e["core_missing"] = not api.finded_com("xray") and not api.finded_com("sing-box")
+	end
 	http_write_json(e)
 end
 
diff --git a/luci-app-passwall2/luasrc/view/passwall2/global/status.htm b/luci-app-passwall2/luasrc/view/passwall2/global/status.htm
index 93e5fe5..304a1a1 100644
--- a/luci-app-passwall2/luasrc/view/passwall2/global/status.htm
+++ b/luci-app-passwall2/luasrc/view/passwall2/global/status.htm
@@ -84,7 +84,7 @@ https://github.com/pure-css/pure/blob/master/LICENSE.md
 
 <fieldset id="_passwall2_status_fieldset" class="cbi-section">
 	<div class="pure-g status">
-		<div class="pure-u-1-4">
+		<div class="pure-u-1-4" id="status_core_card">
 			<div class="block pure-g">
 				<div class="pure-u-1-3">
 					<div class="img-con">
@@ -146,12 +146,31 @@ https://github.com/pure-css/pure/blob/master/LICENSE.md
 					if (true) {
 						var status_node = document.getElementById('status_node');
 						if (status_node) {
-							var text = 'Core<br />';
-							if (data["global_status"])
-								text += '<span class="green"><%:RUNNING%></span>';
-							else
-								text += '<span class="red"><%:NOT RUNNING%></span>';
-							status_node.innerHTML = text;
+							var core_card = document.getElementById('status_core_card');
+							if (core_card) {
+								core_card.classList.remove('check');
+								core_card.onclick = null;
+							}
+							status_node.textContent = data["core_name"] || 'Core';
+							status_node.appendChild(document.createElement('br'));
+							var st = document.createElement('span');
+							if (data["global_status"]) {
+								st.className = 'green';
+								st.textContent = '<%:RUNNING%>';
+							} else if (data["core_missing"]) {
+								st.className = 'red';
+								st.textContent = '<%:NOT INSTALLED%>';
+								if (core_card) {
+									core_card.classList.add('check');
+									core_card.onclick = function () {
+										window.location.href = '<%=api.url("app_update")%>';
+									};
+								}
+							} else {
+								st.className = 'red';
+								st.textContent = '<%:NOT RUNNING%>';
+							}
+							status_node.appendChild(st);
 						}
 					}
 				}
-- 
2.43.0

