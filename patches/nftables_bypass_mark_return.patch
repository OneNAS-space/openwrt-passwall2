From 06bd7a202c49b41ab95365d1e2747214008be7fb Mon Sep 17 00:00:00 2001
From: Jackie Han <jackie.han@gmail.com>
Date: Fri, 30 Oct 2026 18:41:49 +0800
Subject: [PATCH] luci-app-passwall2: skip packets marked 0xff in nftables

Insert a "meta mark 0xff return" rule at the top of dstnat and
mangle_prerouting when the firewall rules are loaded, so packets that an
external script marked 0xff are left alone and go direct.

The rules carry a PSW2_ comment, so del_firewall_rule removes them on stop
and they are re-created on start or after a firewall reload. This replaces
polling and re-inserting them from outside.
---
 luci-app-passwall2/root/usr/share/passwall2/nftables.sh | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/luci-app-passwall2/root/usr/share/passwall2/nftables.sh b/luci-app-passwall2/root/usr/share/passwall2/nftables.sh
index 2a110c0..77f9af0 100755
--- a/luci-app-passwall2/root/usr/share/passwall2/nftables.sh
+++ b/luci-app-passwall2/root/usr/share/passwall2/nftables.sh
@@ -887,6 +887,11 @@ add_firewall_rule() {
 	nft "insert rule $NFTABLE_NAME mangle_output meta skgid $DIRECT_GID counter return comment \"PSW2_DIRECT\""
 	nft "insert rule $NFTABLE_NAME nat_output meta skgid $DIRECT_GID counter return comment \"PSW2_DIRECT\""
 
+	# Packets marked 0xff (e.g. by bypass_guard) skip PassWall2 and go direct.
+	# The PSW2_ comment lets del_firewall_rule remove these on stop.
+	nft "insert rule $NFTABLE_NAME dstnat meta mark 0xff counter return comment \"PSW2_BYPASS_MARK\""
+	nft "insert rule $NFTABLE_NAME mangle_prerouting meta mark 0xff counter return comment \"PSW2_BYPASS_MARK\""
+
 	log_i18n 0 "%s firewall rules load complete!" "nftables"
 }
 
